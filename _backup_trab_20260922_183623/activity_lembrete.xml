<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#07110F"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📚"
        android:textSize="80sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvLembreteTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trabalho"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvLembreteMensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Faltam X dias"
        android:textSize="18sp"
        android:textColor="#AAB5B2"
        android:gravity="center"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnEntendi"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_button"
        android:text="ENTENDI"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>