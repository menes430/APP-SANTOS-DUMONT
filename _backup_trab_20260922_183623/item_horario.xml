<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
        <TextView android:id="@+id/tv_horario" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="7h" android:textColor="@color/primary" android:textStyle="bold" android:textSize="16sp" />
        <TextView android:id="@+id/tv_disciplina" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ART" android:textColor="@color/text_primary" android:textSize="16sp" android:gravity="center" />
        <TextView android:id="@+id/tv_professor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Prof. Cícera" android:textColor="@color/text_secondary" android:textSize="14sp" android:gravity="end" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>