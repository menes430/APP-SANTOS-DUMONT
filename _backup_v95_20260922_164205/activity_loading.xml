<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background_dark">
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_plane"
        android:tint="@color/primary"
        android:layout_marginBottom="16dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Santos Dumont"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APP ESCOLAR"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp" />
    <TextView
        android:id="@+id/tv_funcao_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅ Turmas carregadas!"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />
    <TextView
        android:id="@+id/tv_funcao_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅ Cardápio carregado!"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />
    <TextView
        android:id="@+id/tv_funcao_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅ Horários carregados!"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />
    <TextView
        android:id="@+id/tv_funcao_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅ Professores carregados!"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />
    <TextView
        android:id="@+id/tv_funcao_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅ Notificações prontas!"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />
    <ProgressBar
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:indeterminateTint="@color/primary" />
</LinearLayout>