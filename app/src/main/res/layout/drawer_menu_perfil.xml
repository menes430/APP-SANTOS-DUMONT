<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="true"
    app:cardBackgroundColor="#121716">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecalho Perfil (Clicavel para editar) -->
        <LinearLayout
            android:id="@+id/menuCabecalhoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="#FFFFFF"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/drawerNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome do Aluno"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/drawerTurma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1A MAT"
                    android:textColor="#AAB5B2"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botao: Editar Perfil -->
        <LinearLayout
            android:id="@+id/menuEditarPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_person"
                app:tint="#FFFFFF"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar Perfil"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>

        <!-- Botao: Aparência -->
        <LinearLayout
            android:id="@+id/menuAparencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_book"
                app:tint="#FFFFFF"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aparência (Tema/Fonte)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
