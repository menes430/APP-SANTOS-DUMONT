<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHorarioAulaFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:00"
                android:textColor="#0D99FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDisciplinaAulaFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Matematica"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfessorAulaFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prof. Ana Paula"
                android:textColor="#AAB5B2"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarcarPresenca"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:text="P"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#334ADE80"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarcarFalta"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="F"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#33F87171"
            app:cornerRadius="20dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>