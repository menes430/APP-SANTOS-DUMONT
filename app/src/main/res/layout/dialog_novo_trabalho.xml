<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Nome -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/v9_nome_hint"
        app:boxStrokeColor="@color/primary"
        app:boxBackgroundColor="@color/background_dark"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtNomeTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Data -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/v9_data_hint"
        app:boxStrokeColor="@color/primary"
        app:boxBackgroundColor="@color/background_dark"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/calendar"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDataTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="date"
            android:focusable="false"
            android:clickable="true"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Hora -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/v9_hora_hint"
        app:boxStrokeColor="@color/primary"
        app:boxBackgroundColor="@color/background_dark"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/clock"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtHoraTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="time"
            android:focusable="false"
            android:clickable="true"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Descrição -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/v9_descricao_hint"
        app:boxStrokeColor="@color/primary"
        app:boxBackgroundColor="@color/background_dark"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDescricaoTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Imagem -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/v9_imagem_label"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/v9_camera"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:icon="@drawable/camera"
            app:iconSize="20dp"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGaleria"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/v9_galeria"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:icon="@drawable/foto"
            app:iconSize="20dp"
            app:iconGravity="textStart" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_input"
        android:visibility="gone"
        android:contentDescription="@string/v9_imagem_label"
        android:layout_marginBottom="16dp" />

    <!-- Checkboxes Material -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbAlarme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/v9_programar_alarme"
        android:textColor="@color/text_primary"
        android:checked="true"
        app:buttonTint="@color/primary"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDiaSimDiaNao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/v9_notif_dia_sim_nao"
        android:textColor="@color/text_primary"
        android:checked="true"
        app:buttonTint="@color/primary"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbUltimaSemana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/v9_notif_ultima_semana"
        android:textColor="@color/text_primary"
        android:checked="true"
        app:buttonTint="@color/primary"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbPosAlarme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/v9_notif_pos_alarme"
        android:textColor="@color/text_primary"
        android:checked="false"
        app:buttonTint="@color/primary" />

</LinearLayout>
