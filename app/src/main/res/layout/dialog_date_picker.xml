<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnMesAnterior"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mes anterior" />

        <TextView
            android:id="@+id/tvMesAno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SETEMBRO 2026"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnMesProximo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:rotation="180"
            app:tint="@color/primary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Proximo mes" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView android:text="D" android:textColor="@color/text_primary" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:text="S" android:textColor="#FFFFFF" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:text="T" android:textColor="#FFFFFF" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:text="Q" android:textColor="#FFFFFF" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:text="Q" android:textColor="#FFFFFF" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:text="S" android:textColor="#FFFFFF" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:text="S" android:textColor="@color/text_primary" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/gridDias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="7"
        android:rowCount="6" />

</LinearLayout>