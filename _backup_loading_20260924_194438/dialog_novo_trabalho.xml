<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/edtNomeTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:hint="@string/v9_nome_hint"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB5B2"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtDataTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:hint="@string/v9_data_hint"
            android:inputType="date"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB5B2"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtHoraTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:hint="@string/v9_hora_hint"
            android:inputType="time"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB5B2"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtDescricaoTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:hint="@string/v9_descricao_hint"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB5B2"
            android:autofillHints="none"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/v9_imagem_label"
            android:textColor="#AAB5B2"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_button"
                android:text="@string/v9_camera"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGaleria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button"
                android:text="@string/v9_galeria"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_input"
            android:visibility="gone"
            android:contentDescription="@string/v9_imagem_label"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbAlarme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/v9_programar_alarme"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbDiaSimDiaNao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/v9_notif_dia_sim_nao"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbUltimaSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/v9_notif_ultima_semana"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbPosAlarme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/v9_notif_pos_alarme"
            android:textColor="#FFFFFF"
            android:checked="false" />

    </LinearLayout>
</ScrollView>