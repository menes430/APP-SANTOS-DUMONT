<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_person" android:tint="@color/primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/tv_nome_professor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Professor" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_disciplinas_professor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Matemática, PDV" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_turmas_professor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 turmas" android:textColor="@color/primary" android:textSize="12sp" android:background="@drawable/bg_input" android:padding="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>